  },
  "devDependencies": {
    "@daily-route/config": "workspace:*",
    "@daily-route/transit": "workspace:*",
    "@types/node": "^26.6.5",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
