# ---------------------------------------------------------------------------
# Daily Route — single source of environment configuration.
# Copy to `.env` and fill in. The root `.env` is the ONLY env file in this
# monorepo; every package reads it through `dotenv -e .env --`.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Host development points at the docker-compose `db` service on the host port.
# The compose file overrides this for containerised runs.
DATABASE_URL=postgresql://dailyroute:dailyroute@localhost:5433/dailyroute

# --- Ports -----------------------------------------------------------------
# 3000/3001/4002 are taken by another local stack, so this project uses
# 3010 (web), 3011 (api) and 4012 (worker).
API_PORT=3011
WEB_PORT=3010
WORKER_PORT=4012
WEB_ORIGIN=http://localhost:3010

# --- Agentic model provider (OpenRouter) ----------------------------------
# OpenRouter's OpenAI-compatible root. `AGENT_MODEL` is the exact model id
# and is sent to the provider verbatim.
#
# Models that support tool calls and structured output, and are cheap enough
# for a routing assistant:
#   google/gemini-2.5-flash-lite   the default here: fast, cheap, tools + schema
#   qwen/qwen3.7-flash             the cheapest tool-calling model
#   openai/gpt-4o-mini             a safe, well-known default
#   deepseek/deepseek-v4-pro       stronger reasoning, more expensive
AGENT_BASE_URL=https://openrouter.ai/api/v1
AGENT_API_KEY=
AGENT_MODEL=google/gemini-2.5-flash-lite
# Optional: the decision model for Jev. Defaults to typesafe/jev-1.14.
# JEV_MODEL=

# --- Embeddings (semantic place resolution) -------------------------------
# Any OpenAI-compatible `/embeddings` endpoint. OpenRouter exposes one and
# serves `openai/text-embedding-3-small`; a self-hosted multilingual model
# (gte-multilingual-base, multilingual-e5-large) works better for Indonesian
# place names.
#
# Leave empty to keep place lookup on names and trigrams. A hash of the
# letters is not stored as if it were a semantic vector. The vector column
# stays 768, and the client does not send a dimensions parameter, so the
# model must return 768 numbers.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
# Must match the width of the vector column in Postgres (768).
EMBEDDINGS_DIMENSIONS=768

# --- News research (Tavily) ------------------------------------------------
# https://tavily.com — the agent's `cari_berita` tool. The monitor does not
# poll it; a search happens only when the model asks for news. The free tier
# is 1,000 credits a month.
TAVILY_API_KEY=

# --- Places (Google, optional) ---------------------------------------------
# https://console.cloud.google.com — enable "Places API (New)" and billing.
# The place field asks Google first and keeps every answer inside the
# Jabodetabek rectangle. Without a key, Photon and Nominatim answer instead.
GOOGLE_MAPS_API_KEY=

# --- X (Twitter) monitoring ------------------------------------------------
# An app-only bearer token for the X API v2 filtered stream.
# https://developer.x.com — one stream connection carries a
# `from:<account> -is:retweet` rule per operator, and `from:` includes that
# account's replies. Billing is per post read (about $0.005, capped at three
# million a month); the worker does not poll the timelines.
#
# The accounts that are watched are declared in
# `packages/agent/src/x.ts`:
#   @PT_Transjakarta  Transjakarta
#   @MRTjakartaID     MRT Jakarta
#   @lrtjkt           LRT Jakarta
#   @lrtjabodebek     LRT Jabodebek
#   @KAI121           KAI (the commuter services are announced here)
X_BEARER_TOKEN=
X_API_BASE_URL=https://api.x.com
# --- Classification queue --------------------------------------------------
# A claimed item is leased for CLASSIFY_LEASE_MS; a crash releases it after
# that. The worker drains for CLASSIFY_BUDGET_MS per tick. NOTICE_SWEEP_LIMIT
# is how many open notices a tick
# re-checks for a closing announcement.
CLASSIFY_BUDGET_MS=240000
CLASSIFY_LEASE_MS=600000
CLASSIFY_CONCURRENCY=3
NOTICE_SWEEP_LIMIT=4

# --- Tracing (Langfuse) ----------------------------------------------------
# Optional. When all three are set, the assistant and the disruption
# classifier export traces. LANGFUSE_HOST is accepted as an alias of the
# base URL (US cloud is https://us.cloud.langfuse.com).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# --- Worker ----------------------------------------------------------------
# Set to "false" to run without the background monitor.
WORKER_CRON_ENABLED=true
