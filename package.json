{
  "name": "daily-route",
  "private": true,
  "version": "0.1.0",
  "description": "A public-transit route planner and disruption monitor for Greater Jakarta.",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iqbalShafiq/daily-route.git"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev --filter=@daily-route/api --filter=@daily-route/worker --filter=@daily-route/web",
    "dev:api": "dotenv -e .env -- pnpm --filter @daily-route/api dev",
    "dev:worker": "dotenv -e .env -- pnpm --filter @daily-route/worker dev",
    "dev:web": "dotenv -e .env -- pnpm --filter @daily-route/web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test --concurrency=1",
    "test:e2e": "pnpm --filter @daily-route/web e2e",
    "db:migrate": "dotenv -e .env -- pnpm --filter @daily-route/db migrate",
    "db:seed": "dotenv -e .env -- pnpm --filter @daily-route/db seed",
    "db:sync": "dotenv -e .env -- pnpm --filter @daily-route/db sync",
    "db:reset": "dotenv -e .env -- pnpm --filter @daily-route/db reset",
    "db:studio": "dotenv -e .env -- pnpm --filter @daily-route/db studio",
    "data:ingest": "dotenv -e .env -- pnpm --filter @daily-route/ingest ingest",
    "data:embed": "dotenv -e .env -- pnpm --filter @daily-route/ingest embed",
    "infra:up": "docker compose up -d db",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d db",
    "data:gtfs": "pnpm --filter @daily-route/ingest gtfs",
    "data:enrich": "dotenv -e .env -- pnpm --filter @daily-route/ingest enrich",
    "data:places": "dotenv -e .env -- pnpm --filter @daily-route/ingest places:extract",
    "db:places": "dotenv -e .env -- pnpm --filter @daily-route/ingest places:load",
    "places:check": "dotenv -e .env -- pnpm --filter @daily-route/ingest places:check",
    "places:refresh": "pnpm data:places && pnpm db:places",
    "verify:notices": "dotenv -e .env -- pnpm --filter @daily-route/agent verify:notices",
    "backtest:notices": "dotenv -e .env -- pnpm --filter @daily-route/agent backtest",
    "eval:fetch": "dotenv -e .env -- pnpm --filter @daily-route/agent eval:fetch",
    "eval:notices": "dotenv -e .env -- pnpm --filter @daily-route/agent eval:notices"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.8.1",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@opentelemetry/api": "1.9.1",
      "@opentelemetry/core": "2.12.0",
      "@opentelemetry/resources": "2.12.0",
      "@opentelemetry/sdk-trace-base": "2.12.0",
      "@opentelemetry/sdk-trace": "2.12.0",
      "@opentelemetry/sdk-trace-node": "2.12.0",
      "@opentelemetry/exporter-trace-otlp-http": "0.203.0",
      "@opentelemetry/otlp-exporter-base": "0.203.0",
      "@opentelemetry/otlp-transformer": "0.203.0"
    }
  }
}
